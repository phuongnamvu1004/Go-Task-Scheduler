{
    "swagger": "2.0",
    "info": {
        "description": "Create and manage jobs that run tasks on a schedule.",
        "title": "Go Task Scheduler API",
        "contact": {},
        "version": "0.1.0"
    },
    "basePath": "/",
    "paths": {
        "/health": {
            "get": {
                "description": "Returns 503 if any service is down. Error details are logged, not returned.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health status of each service",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.readinessResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/http.readinessResponse"
                        }
                    }
                }
            }
        },
        "/jobs": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "jobs"
                ],
                "summary": "List jobs of every task type",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/http.jobResponse"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/http.errorResponse"
                        }
                    }
                }
            }
        },
        "/jobs/webhook": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "webhook jobs"
                ],
                "summary": "List webhook jobs",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "allOf": [
                                    {
                                        "$ref": "#/definitions/http.jobResponse"
                                    },
                                    {
                                        "type": "object",
                                        "properties": {
                                            "task": {
                                                "$ref": "#/definitions/task.Webhook"
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/http.errorResponse"
                        }
                    }
                }
            },
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "webhook jobs"
                ],
                "summary": "Create a webhook job",
                "parameters": [
                    {
                        "description": "Webhook job",
                        "name": "job",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.webhookJobRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/http.jobResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "task": {
                                            "$ref": "#/definitions/task.Webhook"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/http.errorResponse"
                        }
                    }
                }
            }
        },
        "/jobs/webhook/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "webhook jobs"
                ],
                "summary": "Get a webhook job",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Job ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/http.jobResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "task": {
                                            "$ref": "#/definitions/task.Webhook"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/http.errorResponse"
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "webhook jobs"
                ],
                "summary": "Delete a webhook job",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Job ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/http.errorResponse"
                        }
                    }
                }
            },
            "patch": {
                "description": "Partial update: only the fields in the body change, the rest keep their current value.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "webhook jobs"
                ],
                "summary": "Update a webhook job",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Job ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Fields to change",
                        "name": "job",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.webhookJobPatchRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/http.jobResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "task": {
                                            "$ref": "#/definitions/task.Webhook"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/http.errorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/http.errorResponse"
                        }
                    }
                }
            }
        },
        "/jobs/webhook/{id}/pause": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "webhook jobs"
                ],
                "summary": "Pause a webhook job",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Job ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/http.jobResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "task": {
                                            "$ref": "#/definitions/task.Webhook"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/http.errorResponse"
                        }
                    }
                }
            }
        },
        "/jobs/webhook/{id}/resume": {
            "post": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "webhook jobs"
                ],
                "summary": "Resume a paused webhook job",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Job ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/http.jobResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "task": {
                                            "$ref": "#/definitions/task.Webhook"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/http.errorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "http.errorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "http.jobResponse": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "schedule": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/job.Status"
                },
                "task": {},
                "task_type": {
                    "$ref": "#/definitions/task.Type"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "http.readinessResponse": {
            "type": "object",
            "properties": {
                "services": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/http.serviceStatusResponse"
                    }
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "http.serviceStatusResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string"
                }
            }
        },
        "http.webhookJobPatchRequest": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "schedule": {
                    "type": "string"
                },
                "task": {
                    "$ref": "#/definitions/http.webhookTaskPatchRequest"
                }
            }
        },
        "http.webhookJobRequest": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "schedule": {
                    "type": "string"
                },
                "task": {
                    "$ref": "#/definitions/task.Webhook"
                }
            }
        },
        "http.webhookTaskPatchRequest": {
            "type": "object",
            "properties": {
                "body": {
                    "type": "string"
                },
                "headers": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "method": {
                    "$ref": "#/definitions/task.HTTPMethod"
                },
                "url": {
                    "type": "string"
                }
            }
        },
        "job.Status": {
            "type": "string",
            "enum": [
                "active",
                "paused"
            ],
            "x-enum-varnames": [
                "StatusActive",
                "StatusPaused"
            ]
        },
        "task.HTTPMethod": {
            "type": "string",
            "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE"
            ],
            "x-enum-varnames": [
                "MethodGET",
                "MethodPOST",
                "MethodPUT",
                "MethodPATCH",
                "MethodDELETE"
            ]
        },
        "task.Type": {
            "type": "string",
            "enum": [
                "webhook"
            ],
            "x-enum-varnames": [
                "TypeWebhook"
            ]
        },
        "task.Webhook": {
            "type": "object",
            "properties": {
                "body": {
                    "type": "string"
                },
                "headers": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "method": {
                    "$ref": "#/definitions/task.HTTPMethod"
                },
                "url": {
                    "type": "string"
                }
            }
        }
    }
}